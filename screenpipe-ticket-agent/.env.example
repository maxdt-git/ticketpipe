# --- screenpipe ---
SCREENPIPE_URL=http://localhost:3030
# Get it with: screenpipe auth token
SCREENPIPE_API_KEY=
# Content types to pull from /search (comma-separated): ocr, ui, audio
CONTENT_TYPES=ocr,ui
# How far back to look when building a ticket (minutes)
LOOKBACK_MINUTES=15
# Max characters of context sent to the LLM
MAX_CONTEXT_CHARS=12000
# Replay a saved screenpipe response instead of calling the API (demo / offline)
# CONTEXT_FILE=fixtures/vpn-error.json

# --- LLM ---
# anthropic | openai | mock   (mock = no API call, deterministic ticket for tests)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible endpoint works (Mistral, Ollama, LM Studio...)
OPENAI_BASE_URL=https://api.openai.com/v1
# Language of the generated ticket
TICKET_LANGUAGE=en

# --- GitHub Issues ---
# Fine-grained token with "Issues: Read and write" on the target repo.
# Leave empty to run in dry-run mode (tickets saved to ./out/).
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- server ---
PORT=4242
